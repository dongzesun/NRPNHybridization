    f.write("""
ConsSpec=[{ConsSpec},('EvolveSpin1',boolean),('EvolveSpin2',boolean)]
@jitclass(ConsSpec)
class Cons:
    def __init__(self,{ConsArgu},EvolveSpin1,EvolveSpin2):
{ConsInit}
        self.EvolveSpin1=EvolveSpin1
        self.EvolveSpin2=EvolveSpin2

VarsSpec=[{VarsSpec}]
